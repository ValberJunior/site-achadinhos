# Copie para .env.local em dev, ou configure como env vars no deploy (mesmo
# Docker Compose da VPS2 — ver README.md e Infra.md do projeto).

# Postgres — o MESMO banco/instância usado pelos workflows n8n (W1-W10),
# apontando pra esta app apenas em modo leitura na prática (o site nunca
# escreve em coupons/whatsapp_groups, só lê — só escreve em site_leads).
DATABASE_URL="postgres://####:####@####:5432/####"

# URL pública do site (usada em metadata, sitemap, JSON-LD, OG)
NEXT_PUBLIC_SITE_URL="####"

# Facebook Pixel — PageView/ViewContent/Lead/clique no link de afiliado
NEXT_PUBLIC_FB_PIXEL_ID="####"

# Evolution API (mesma instância já usada no resto do projeto/n8n, ver
# Infra.md) — usada pra criar grupo novo quando todos os do nicho estão
# cheios (src/lib/evolution.ts) e pra autenticar o webhook de entrada de
# participante (src/app/api/webhooks/evolution/route.ts).
EVOLUTION_API_URL="####"
EVOLUTION_API_KEY="####"
EVOLUTION_INSTANCE="####"
# Número (com DDI, só dígitos, ex.: 5511999999999) da instância WhatsApp
# conectada no Evolution API — é quem cria/administra os grupos. Entradas
# desse número num grupo são ignoradas pelo webhook (é o bootstrap do
# grupo, não uma pessoa entrando de verdade).
EVOLUTION_ADMIN_PHONE="####"
# Segredo compartilhado só pra autenticar o POST do webhook (?token=...) —
# gere uma string aleatória qualquer e use a mesma nos dois lados.
EVOLUTION_WEBHOOK_SECRET="####"

# Link do grupo de WhatsApp mostrado no botão "ENTRAR NO GRUPO" da home
# (pagina de captura "Listinha da Bru"). Troque pelo link real do grupo.
NEXT_PUBLIC_WHATSAPP_GROUP_URL="https://chat.whatsapp.com/SEU_LINK_AQUI"

# Obs: o intervalo de revalidação ISR (30min) é um literal fixo no código
# (src/app/page.tsx e src/app/nicho/[slug]/page.tsx) — o Next exige que
# `export const revalidate` seja estático, não dá pra vir de env var. Pra
# mudar o intervalo, edite o valor direto nesses dois arquivos.
